index 0000000..1dd848f
--- /dev/null
+++ b/tests/test_http_length_post.py
@@ -0,0 +1,247 @@
+"""非法 Content-Length 的 POST 必须得到结构化 400，而不是断连（真实 Unix socket + 字面 HTTP 请求，无 mock Handler）。
+
+`http.client` 会拒绝发送非数字的 Content-Length，所以这里用裸 socket 逐字节发字面请求行/header。
+校验点：错误响应状态与 JSON 错误结构、合法 POST 会话创建、以及错误之后同一进程仍可正常服务 GET/POST。
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import shutil
+import signal
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+CAPS = ["session_binding", "step_injection", "tool_capture", "compaction_capture", "subagent_capture", "note_tool", "query_tools"]
+PROTOCOL_HEADER = "X-CrowdMemory-Protocol-Major"
+TOKEN_HEADER = "X-CrowdMemory-Adapter-Token"
+SESSION_START = "/v1/agent-ingress/dsh/events/session.start"
+
+
+@pytest.fixture
+def state_root():
+    root = Path(tempfile.mkdtemp(prefix="exi-cl-", dir="/tmp"))
+    yield root
+    shutil.rmtree(root, ignore_errors=True)
+
+
+def _spawn(root: Path, *extra: str) -> tuple[subprocess.Popen, dict]:
+    (root / "endpoint.json").unlink(missing_ok=True)
+    process = subprocess.Popen(
+        [sys.executable, "-m", "crowdmemory_runtime", "serve-dev", "--state-root", str(root),
+         "--socket", str(root / "runtime.sock"), "--profile", "session-default", *extra],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, env={**os.environ, "HOME": str(root)},
+    )
+    deadline = time.monotonic() + 20
+    while time.monotonic() < deadline:
+        if (root / "endpoint.json").is_file() and (root / "runtime.sock").exists():
+            return process, json.loads((root / "endpoint.json").read_text())
+        if process.poll() is not None:
+            raise AssertionError(process.stderr.read().decode())
+        time.sleep(0.05)
+    process.kill()
+    raise AssertionError("serve-dev did not publish endpoint.json")
+
+
+def _stop(process: subprocess.Popen, sig=signal.SIGTERM) -> None:
+    if process.poll() is None:
+        process.send_signal(sig)
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+
+
+def _token(endpoint: dict) -> str:
+    return Path(endpoint["token_file"]).read_text(encoding="utf-8").strip()
+
+
+def _session_start_body(event_id: str | None = None) -> bytes:
+    body = {
+        "adapter_id": "dsh",
+        "event_id": event_id or "sha256:" + hashlib.sha256(f"session.start:{time.time_ns()}".encode()).hexdigest(),
+        "session_ref": "dsh-cl",
+        "parent_ref": None,
+        "occurred_at": "2026-10-20T00:00:00Z",
+        "kind": "session.start",
+        "payload": {"project": "demo", "profile_ref": "session-default", "capabilities": CAPS},
+    }
+    return json.dumps(body).encode("utf-8")
+
+
+def _raw_exchange(socket_path: str, request: bytes, timeout: float = 5.0) -> bytes:
+    """字面 HTTP 请求 -> 服务端响应原始字节。连接被直接关闭时返回 b''。"""
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    sock.settimeout(timeout)
+    try:
+        sock.connect(socket_path)
+        sock.sendall(request)
+        chunks: list[bytes] = []
+        while True:
+            chunk = sock.recv(65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+    except socket.timeout:  # 服务端既没回应也没关闭：同样视为不可用
+        return b"".join(chunks)
+    finally:
+        sock.close()
+    return b"".join(chunks)
+
+
+def _post_with_content_length(endpoint: dict, content_length: str, body: bytes = b"", *, protocol: str | None = "1") -> bytes:
+    lines = [f"POST {SESSION_START} HTTP/1.1", "Host: localhost", "Content-Type: application/json",
+             f"{TOKEN_HEADER}: {_token(endpoint)}"]
+    if protocol is not None:
+        lines.append(f"{PROTOCOL_HEADER}: {protocol}")
+    lines.append(f"Content-Length: {content_length}")
+    request = ("\r\n".join(lines) + "\r\n\r\n").encode("utf-8") + body
+    return _raw_exchange(endpoint["socket_path"], request)
+
+
+def _post_body(endpoint: dict, body: bytes) -> bytes:
+    return _post_with_content_length(endpoint, str(len(body)), body)
+
+
+def _get_status(endpoint: dict) -> bytes:
+    request = ("\r\n".join([
+        "GET /v1/status HTTP/1.1", "Host: localhost", f"{PROTOCOL_HEADER}: 1", f"{TOKEN_HEADER}: {_token(endpoint)}",
+    ]) + "\r\n\r\n").encode("utf-8")
+    return _raw_exchange(endpoint["socket_path"], request)
+
+
+def _split(raw: bytes) -> tuple[int, dict]:
+    """原始响应 -> (状态码, JSON 对象)。空响应直接断言失败，把"断连"暴露成可读的错误。"""
+    assert raw, "服务端返回空响应：连接被直接断开，调用方拿不到任何结构化错误"
+    head, _, payload = raw.partition(b"\r\n\r\n")
+    status_line = head.split(b"\r\n", 1)[0].decode("latin-1")
+    status = int(status_line.split()[1])
+    assert "application/json" in head.decode("latin-1")
+    value = json.loads(payload)
+    assert isinstance(value, dict)
+    return status, value
+
+
+def _assert_invalid_content_length_error(status: int, value: dict) -> None:
+    assert status == 400, value
+    assert value["ok"] is False, value
+    error = value["error"]
+    assert error["code"] == "invalid_content_length", value
+    assert isinstance(error["message"], str) and error["message"], value
+    assert error["retryable"] is False, value
+
+
+def test_post_session_start_with_non_numeric_content_length_returns_400(state_root) -> None:
+    """core regression: Content-Length: abc 在 POST session.start 上必须是结构化 400，而不是断连。"""
+    process, endpoint = _spawn(state_root)
+    try:
+        status, value = _split(_post_with_content_length(endpoint, "abc", _session_start_body()))
+        _assert_invalid_content_length_error(status, value)
+        # 错误请求没有副作用：紧接着的合法 POST 仍能创建会话
+        status, value = _split(_post_body(endpoint, _session_start_body()))
+        assert status == 200 and value["ok"], value
+        assert re.fullmatch(r"[A-Za-z0-9_-]{1,128}", value["result"]["session_handle"]), value
+    finally:
+        _stop(process)
+    assert process.returncode == 0
+
+
+@pytest.mark.parametrize("content_length", ["abc", "12abc", "1.5", "0x20", "+", "1 2", "-abc"])
+def test_non_numeric_content_length_variants_return_400(state_root, content_length: str) -> None:
+    process, endpoint = _spawn(state_root)
+    try:
+        status, value = _split(_post_with_content_length(endpoint, content_length))
+        _assert_invalid_content_length_error(status, value)
+        # 每个变体之后服务端仍存活且可用
+        status, value = _split(_get_status(endpoint))
+        assert status == 200 and value["lifecycle_protocol"]["protocol_major"] == 1, value
+    finally:
+        _stop(process)
+
+
+def test_empty_content_length_is_treated_as_empty_body(state_root) -> None:
+    """空 Content-Length 按 HTTP 语义就是"没有请求体"：走正常路由，不是 invalid_content_length。
+
+    这条刻意区分于上面的非数字变体，避免把"看起来像非法"的空值也算进修复面。
+    """
+    process, endpoint = _spawn(state_root)
+    try:
+        status, value = _split(_post_with_content_length(endpoint, ""))
+        assert status == 400, value
+        assert value["ok"] is False and value["error"]["code"] == "schema_invalid", value
+        status, value = _split(_get_status(endpoint))
+        assert status == 200 and value["lifecycle_protocol"]["protocol_major"] == 1, value
+    finally:
+        _stop(process)
+
+
+def test_negative_and_oversize_content_length_stay_413(state_root) -> None:
+    """边界邻居：负数与超限仍走既有 request_too_large，本修复不改变它们的分支。"""
+    from crowdmemory_runtime.protocol import MAX_MESSAGE_BYTES
+
+    process, endpoint = _spawn(state_root)
+    try:
+        for content_length in ("-1", str(MAX_MESSAGE_BYTES + 1)):
+            status, value = _split(_post_with_content_length(endpoint, content_length))
+            assert status == 413, (content_length, value)
+            assert value["ok"] is False and value["error"]["code"] == "request_too_large", value
+    finally:
+        _stop(process)
+
+
+def test_valid_post_and_status_survive_after_invalid_content_length(state_root) -> None:
+    """错误响应之后，正常 POST 会话创建与 GET /v1/status 都必须不受影响。"""
+    process, endpoint = _spawn(state_root)
+    try:
+        status, value = _split(_get_status(endpoint))
+        assert status == 200 and value["lifecycle_protocol"]["protocol_major"] == 1, value
+
+        status, value = _split(_post_with_content_length(endpoint, "abc", _session_start_body()))
+        _assert_invalid_content_length_error(status, value)
+
+        body = _session_start_body()
+        status, value = _split(_post_body(endpoint, body))
+        assert status == 200 and value["ok"], value
+        handle = value["result"]["session_handle"]
+
+        # 同一 event_id 重放是幂等的，说明正常路径没有被打断
+        status, value = _split(_post_body(endpoint, body))
+        assert status == 200 and value["ok"], value
+        assert value["result"]["session_handle"] == handle
+
+        status, value = _split(_get_status(endpoint))
+        assert status == 200 and value["lifecycle_protocol"]["protocol_major"] == 1, value
+
+        # 非数字 Content-Length 也必须先读完请求体（这里带了 body）而不是在写请求体时被关连接
+        status, value = _split(_post_with_content_length(endpoint, "abc", _session_start_body()))
+        _assert_invalid_content_length_error(status, value)
+        status, value = _split(_get_status(endpoint))
+        assert status == 200 and value["lifecycle_protocol"]["protocol_major"] == 1, value
+    finally:
+        _stop(process)
+    assert process.returncode == 0
+
+
+def test_invalid_content_length_does_not_leak_traceback_to_stderr(state_root) -> None:
+    """异常不能穿出 handler：stderr 里不应出现本次请求的 ValueError/traceback。"""
+    process, endpoint = _spawn(state_root)
+    try:
+        status, value = _split(_post_with_content_length(endpoint, "abc", _session_start_body()))
+        _assert_invalid_content_length_error(status, value)
+        status, value = _split(_get_status(endpoint))
+        assert status == 200
+    finally:
+        _stop(process)
+    stderr = process.stderr.read().decode("utf-8", "replace")
+    assert "Traceback" not in stderr, stderr[-2000:]
+    assert "invalid literal for int()" not in stderr, stderr[-2000:]
