  "captions": [
    {
      "scene": "intro",
      "start": 0.1,
      "end": 4.367,
      "text": "Crowd Memory 是面向 coding Agent 的组织级记忆组件。"
    },
    {
      "scene": "intro",
      "start": 4.4,
      "end": 11.229,
      "text": "任务轨迹和笔记形成经验，经中心审核发布后，供组织内其他节点的 Agent 使用。"
    },
    {
      "scene": "intro",
      "start": 11.262,
      "end": 18.754,
      "text": "这里用鸿蒙 PC 的 Python 三方库适配，看 apriltag 的修法怎样用于 RDKit 的相关问题。"
    },
    {
      "scene": "center",
      "start": 18.787,
      "end": 22.167,
      "text": "先启动中心的 Git 服务和收集进程。"
    },
    {
      "scene": "center",
      "start": 22.2,
      "end": 26.954,
      "text": "Raw 接收各节点上报的数据，Release 分发审核后的经验。"
    },
    {
      "scene": "center",
      "start": 26.987,
      "end": 30.842,
      "text": "屏幕上能看到中心地址和演示共享组。"
    },
    {
      "scene": "runtimes",
      "start": 30.875,
      "end": 34.767,
      "text": "接着分别启动节点 A 和节点 B 的 Runtime。"
    },
    {
      "scene": "runtimes",
      "start": 34.8,
      "end": 39.154,
      "text": "两端使用各自的端点和数据库，连接同一个中心。"
    },
    {
      "scene": "runtimes",
      "start": 39.187,
      "end": 44.317,
      "text": "这里在本机运行两个独立节点，演示组织内的共享过程。"
    },
    {
      "scene": "config",
      "start": 44.35,
      "end": 50.792,
      "text": "DSH 的 Profile 加载记忆适配器，设置本节点的端点、项目和采集模板。"
    },
    {
      "scene": "config",
      "start": 50.825,
      "end": 57.742,
      "text": "两端的共享配置使用不同的节点编号，指向相同的 Raw、Release 和共享组。"
    },
    {
      "scene": "a_fix",
      "start": 57.775,
      "end": 63.217,
      "text": "Agent 一处理 apriltag-python，它用于识别 AprilTag 视觉标记。"
    },
    {
      "scene": "a_fix",
      "start": 63.25,
      "end": 67.279,
      "text": "原生库文件已经存在，验证进程却找不到。"
    },
    {
      "scene": "a_fix",
      "start": 67.312,
      "end": 74.067,
      "text": "Agent 一先复现启动脚本问题，再把库目录写入环境，三项启动测试通过。"
    },
    {
      "scene": "pipeline",
      "start": 74.1,
      "end": 77.667,
      "text": "轨迹和笔记从节点 A 回流到中心。"
    },
    {
      "scene": "pipeline",
      "start": 77.7,
      "end": 84.429,
      "text": "中心聚合同一问题的证据，形成 Candidate，核对结构、来源和回放结果。"
    },
    {
      "scene": "pipeline",
      "start": 84.462,
      "end": 88.567,
      "text": "这里只有一个来源，核验结果要求人工审核。"
    },
    {
      "scene": "card",
      "start": 88.6,
      "end": 95.304,
      "text": "这张 Memory Card 写明了触发条件、原因和修法，并保留原始适配记录的出处。"
    },
    {
      "scene": "card",
      "start": 95.337,
      "end": 101.217,
      "text": "关键动作是在启动进程之前导出原生库路径，同时保留已有路径。"
    },
    {
      "scene": "release",
      "start": 101.25,
      "end": 105.617,
      "text": "审核人批准后，中心把卡片发布到演示共享组。"
    },
    {
      "scene": "release",
      "start": 105.65,
      "end": 111.267,
      "text": "节点 B 从 Release 同步到审核后的组织记录，来源仍指向节点 A。"
    },
    {
      "scene": "release",
      "start": 111.3,
      "end": 116.629,
      "text": "两个节点分别保存本地数据，交换的是共享组内发布的经验。"
    },
    {
      "scene": "b_injection",
      "start": 116.662,
      "end": 122.517,
      "text": "Agent 二处理 nerdd-module，它依赖的 RDKit 也遇到了原生库路径问题。"
    },
    {
      "scene": "b_injection",
      "start": 122.55,
      "end": 128.004,
      "text": "Crowd Memory 在执行前把组织卡片送入 DSH 上下文。"
    },
    {
      "scene": "b_injection",
      "start": 128.037,
      "end": 132.904,
      "text": "展开这里，可以看到卡片编号、审核来源和匹配理由。"
    },
    {
      "scene": "b_apply",
      "start": 132.937,
      "end": 138.167,
      "text": "Agent 二打开卡片后，采用了先配置环境再启动进程的做法。"
    },
    {
      "scene": "b_apply",
      "start": 138.2,
      "end": 143.967,
      "text": "这次使用 RDKit 的点 libs 目录，代码修改保留了原有的搜索路径。"
    },
    {
      "scene": "b_test",
      "start": 144.0,
      "end": 152.267,
      "text": "用同一条命令重跑启动测试，检查目录是否传给子进程、已有路径是否保留，以及空值处理。"
    },
    {
      "scene": "b_test",
      "start": 152.3,
      "end": 154.204,
      "text": "这三项都通过了。"
    },
    {
      "scene": "usage",
      "start": 154.237,
      "end": 156.867,
      "text": "最后核对节点 B 的使用记录。"
    },
    {
      "scene": "usage",
      "start": 156.9,
      "end": 162.954,
      "text": "同一张组织卡片下，记录了自动注入、读取和引用，来源是节点 A。"
    },
    {
      "scene": "usage",
      "start": 162.987,
      "end": 169.875,
      "text": "结合刚才的脚本修改与测试结果，可以看到这条经验怎样进入另一个节点的任务。"
    }
  ],
