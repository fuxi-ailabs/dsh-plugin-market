  "captions": [
    {
      "scene": "intro",
      "start": 0.1,
      "end": 4.367,
      "text": "Crowd Memory 是面向 coding Agent 的组织级记忆组件。"
    },
    {
      "scene": "intro",
      "start": 4.4,
      "end": 12.529,
      "text": "任务轨迹和笔记形成经验，由中心自动核验，达到发布门槛后，供组织内其他节点的 Agent 使用。"
    },
    {
      "scene": "intro",
      "start": 12.562,
      "end": 20.054,
      "text": "这里用鸿蒙 PC 的 Python 三方库适配，看 apriltag 的修法怎样用于 RDKit 的相关问题。"
    },
    {
      "scene": "center",
      "start": 20.087,
      "end": 23.467,
      "text": "先启动中心的 Git 服务和收集进程。"
    },
    {
      "scene": "center",
      "start": 23.5,
      "end": 28.429,
      "text": "Raw 接收各节点上报的数据，Release 分发核验通过的经验。"
    },
    {
      "scene": "center",
      "start": 28.462,
      "end": 32.317,
      "text": "屏幕上能看到中心地址和演示共享组。"
    },
    {
      "scene": "runtimes",
      "start": 32.35,
      "end": 36.242,
      "text": "接着分别启动节点 A 和节点 B 的 Runtime。"
    },
    {
      "scene": "runtimes",
      "start": 36.275,
      "end": 40.629,
      "text": "两端使用各自的端点和数据库，连接同一个中心。"
    },
    {
      "scene": "runtimes",
      "start": 40.662,
      "end": 45.792,
      "text": "这里在本机运行两个独立节点，演示组织内的共享过程。"
    },
    {
      "scene": "config",
      "start": 45.825,
      "end": 52.267,
      "text": "DSH 的 Profile 加载记忆适配器，设置本节点的端点、项目和采集模板。"
    },
    {
      "scene": "config",
      "start": 52.3,
      "end": 59.217,
      "text": "两端的共享配置使用不同的节点编号，指向相同的 Raw、Release 和共享组。"
    },
    {
      "scene": "a_fix",
      "start": 59.25,
      "end": 64.692,
      "text": "Agent 一处理 apriltag-python，它用于识别 AprilTag 视觉标记。"
    },
    {
      "scene": "a_fix",
      "start": 64.725,
      "end": 68.754,
      "text": "原生库文件已经存在，验证进程却找不到。"
    },
    {
      "scene": "a_fix",
      "start": 68.787,
      "end": 75.542,
      "text": "Agent 一先复现启动脚本问题，再把库目录写入环境，三项启动测试通过。"
    },
    {
      "scene": "pipeline",
      "start": 75.575,
      "end": 79.142,
      "text": "轨迹和笔记从节点 A 回流到中心。"
    },
    {
      "scene": "pipeline",
      "start": 79.175,
      "end": 85.904,
      "text": "中心聚合同一问题的证据，形成 Candidate，核对结构、来源和回放结果。"
    },
    {
      "scene": "pipeline",
      "start": 85.937,
      "end": 91.692,
      "text": "核验通过的经验自动发布，证据不足的候选继续积累后续任务的记录。"
    },
    {
      "scene": "card",
      "start": 91.725,
      "end": 98.429,
      "text": "这张 Memory Card 写明了触发条件、原因和修法，并保留原始适配记录的出处。"
    },
    {
      "scene": "card",
      "start": 98.462,
      "end": 104.342,
      "text": "关键动作是在启动进程之前导出原生库路径，同时保留已有路径。"
    },
    {
      "scene": "release",
      "start": 104.375,
      "end": 108.817,
      "text": "候选通过自动核验后，中心把经验发布到共享组。"
    },
    {
      "scene": "release",
      "start": 108.85,
      "end": 114.329,
      "text": "节点 B 从 Release 同步经过核验的组织记录，来源仍指向节点 A。"
    },
    {
      "scene": "release",
      "start": 114.362,
      "end": 119.692,
      "text": "两个节点分别保存本地数据，交换的是共享组内发布的经验。"
    },
    {
      "scene": "b_injection",
      "start": 119.725,
      "end": 125.579,
      "text": "Agent 二处理 nerdd-module，它依赖的 RDKit 也遇到了原生库路径问题。"
    },
    {
      "scene": "b_injection",
      "start": 125.612,
      "end": 131.067,
      "text": "Crowd Memory 在执行前把组织卡片送入 DSH 上下文。"
    },
    {
      "scene": "b_injection",
      "start": 131.1,
      "end": 135.842,
      "text": "展开这里，可以看到卡片编号、记录来源和匹配理由。"
    },
    {
      "scene": "b_apply",
      "start": 135.875,
      "end": 141.104,
      "text": "Agent 二打开卡片后，采用了先配置环境再启动进程的做法。"
    },
    {
      "scene": "b_apply",
      "start": 141.137,
      "end": 146.904,
      "text": "这次使用 RDKit 的点 libs 目录，代码修改保留了原有的搜索路径。"
    },
    {
      "scene": "b_test",
      "start": 146.937,
      "end": 155.204,
      "text": "用同一条命令重跑启动测试，检查目录是否传给子进程、已有路径是否保留，以及空值处理。"
    },
    {
      "scene": "b_test",
      "start": 155.237,
      "end": 157.142,
      "text": "这三项都通过了。"
    },
    {
      "scene": "usage",
      "start": 157.175,
      "end": 159.804,
      "text": "最后核对节点 B 的使用记录。"
    },
    {
      "scene": "usage",
      "start": 159.837,
      "end": 165.892,
      "text": "同一张组织卡片下，记录了自动注入、读取和引用，来源是节点 A。"
    },
    {
      "scene": "usage",
      "start": 165.925,
      "end": 172.812,
      "text": "结合刚才的脚本修改与测试结果，可以看到这条经验怎样进入另一个节点的任务。"
    }
  ],
