  "captions": [
    {
      "scene": "intro",
      "start": 0.1,
      "end": 4.367,
      "text": "Crowd Memory 是面向 coding Agent 的组织级记忆组件。"
    },
    {
      "scene": "intro",
      "start": 4.4,
      "end": 11.942,
      "text": "任务轨迹和笔记从不同节点回流到中心，经过证据核验，形成组织内可复用的经验。"
    },
    {
      "scene": "intro",
      "start": 11.975,
      "end": 19.454,
      "text": "这里用鸿蒙 PC 的 Python 三方库适配，看 apriltag 的做法怎样用于 RDKit 的相关问题。"
    },
    {
      "scene": "center",
      "start": 19.487,
      "end": 21.417,
      "text": "先启动组织中心。"
    },
    {
      "scene": "center",
      "start": 21.45,
      "end": 26.954,
      "text": "Raw 接收节点上报的数据，Release 分发通过证据核验的组织卡片。"
    },
    {
      "scene": "center",
      "start": 26.987,
      "end": 29.679,
      "text": "两端使用同一个组织共享组。"
    },
    {
      "scene": "runtimes",
      "start": 29.712,
      "end": 33.242,
      "text": "分别启动节点 A 和节点 B 的 Runtime。"
    },
    {
      "scene": "runtimes",
      "start": 33.275,
      "end": 38.217,
      "text": "两端拥有独立的端点和数据库，通过中心交换组织经验。"
    },
    {
      "scene": "config",
      "start": 38.25,
      "end": 44.004,
      "text": "在 DSH 的 Profile 中加载记忆适配器，指定本节点的 Runtime 端点。"
    },
    {
      "scene": "config",
      "start": 44.037,
      "end": 50.192,
      "text": "配置里可以看到不同的节点编号，以及相同的 Raw、Release 和共享组。"
    },
    {
      "scene": "a_fix",
      "start": 50.225,
      "end": 54.704,
      "text": "Agent 一处理 apriltag-python，它用于识别视觉标记。"
    },
    {
      "scene": "a_fix",
      "start": 54.737,
      "end": 59.754,
      "text": "库目录已经传给启动脚本，子进程却没有得到搜索路径。"
    },
    {
      "scene": "a_fix",
      "start": 59.787,
      "end": 64.854,
      "text": "补上这一行导出，再跑相同的测试命令，三项测试通过。"
    },
    {
      "scene": "pipeline",
      "start": 64.887,
      "end": 70.942,
      "text": "Runtime 把修前失败、代码修改和修后结果配成证据，回流到中心。"
    },
    {
      "scene": "pipeline",
      "start": 70.975,
      "end": 80.792,
      "text": "中心将 apriltag 与 Pillow、TA-Lib 等项目的记录聚合成 Candidate，核对原始证据、修改约束、一致性和独立来源。"
    },
    {
      "scene": "card",
      "start": 80.825,
      "end": 85.767,
      "text": "这张 Memory Card 写明了触发条件、原因、修法和出处。"
    },
    {
      "scene": "card",
      "start": 85.8,
      "end": 92.017,
      "text": "关键动作是在启动进程之前导出原生库目录，同时保留已有搜索路径。"
    },
    {
      "scene": "release",
      "start": 92.05,
      "end": 96.379,
      "text": "证据核验通过后，中心把卡片发布到组织试推。"
    },
    {
      "scene": "release",
      "start": 96.412,
      "end": 98.817,
      "text": "屏幕上的状态是 trial。"
    },
    {
      "scene": "release",
      "start": 98.85,
      "end": 104.804,
      "text": "节点 B 从 Release 同步卡片，后续的使用回执继续回流，用于效果评估。"
    },
    {
      "scene": "b_injection",
      "start": 104.837,
      "end": 108.492,
      "text": "Agent 二处理依赖 RDKit 的 nerdd-module。"
    },
    {
      "scene": "b_injection",
      "start": 108.525,
      "end": 113.254,
      "text": "RDKit 用于分子数据处理，也遇到了原生库路径问题。"
    },
    {
      "scene": "b_injection",
      "start": 113.287,
      "end": 119.467,
      "text": "展开 DSH 的推送消息，可以看到组织卡片编号、来源和匹配理由。"
    },
    {
      "scene": "b_apply",
      "start": 119.5,
      "end": 124.654,
      "text": "Agent 二打开卡片，采用先配置环境、再启动进程的做法。"
    },
    {
      "scene": "b_apply",
      "start": 124.687,
      "end": 131.329,
      "text": "这次按 RDKit 的目录重新定位到点 libs，保留原有路径，完成一行修改。"
    },
    {
      "scene": "b_test",
      "start": 131.362,
      "end": 137.329,
      "text": "用同一条命令复测，检查目录传递、已有路径保留和空值处理。"
    },
    {
      "scene": "b_test",
      "start": 137.362,
      "end": 139.554,
      "text": "三项测试全部通过。"
    },
    {
      "scene": "usage",
      "start": 139.587,
      "end": 142.267,
      "text": "最后查看节点 B 的使用记录。"
    },
    {
      "scene": "usage",
      "start": 142.3,
      "end": 146.429,
      "text": "组织卡片的推送、读取和引用都留下了回执。"
    },
    {
      "scene": "usage",
      "start": 146.462,
      "end": 152.825,
      "text": "结合刚才的代码修改与测试结果，可以看到组织经验怎样被后续任务采用。"
    }
  ],
