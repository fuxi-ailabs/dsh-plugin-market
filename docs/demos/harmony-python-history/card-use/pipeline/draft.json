  "fix": {
    "diff": "--- a/launch-verification.sh\n+++ b/launch-verification.sh\n@@ -2,4 +2,5 @@\n set -euo pipefail\n native_dir=$1\n shift\n+export LD_LIBRARY_PATH=\"$native_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"\n exec \"$@\"\n",
