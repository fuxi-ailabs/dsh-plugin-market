+++ b/distributions/memory-runtime/src/crowdmemory_runtime/server.py
@@ -605 +605,12 @@ class MemoryServer:
-                length = int(self.headers.get("Content-Length") or 0)
+                # Framing is validated before anything is read: an unparsable length cannot
+                # describe a body, so the client must get a structured 400 instead of a
+                # dropped connection (an escaping ValueError kills the handler thread).
+                declared = self.headers.get("Content-Length")
+                try:
+                    length = 0 if declared is None or not declared.strip() else int(declared.strip())
+                except ValueError:
+                    # 长度无法解析 => 消息边界不可判定，按 RFC 7230 §3.3.3 回 400 后关闭连接，
+                    # 否则残留字节会被当成下一条请求。
+                    self.close_connection = True
+                    self._respond(400, _wire_error("invalid_content_length", "Content-Length 必须是十进制整数"))
+                    return
diff --git a/tests/test_http_length_demo.py b/tests/test_http_length_demo.py
new file mode 100644
index 0000000..f545cc0
--- /dev/null
+++ b/tests/test_http_length_demo.py
@@ -0,0 +1,144 @@
+"""HTTP framing over the real Unix-socket service: a malformed ``Content-Length`` must not cost the client its response.
+
+The reported symptom was a connection that closed with zero bytes when the client sent
+``X-CrowdMemory-Protocol-Major: 1`` together with ``Content-Length: abc`` on ``GET /v1/status``.
+These tests talk raw HTTP/1.1 over ``AF_UNIX`` to a real ``serve-dev`` process, so the framing
+layer under test is the server's own ``_handle`` — nothing here replaces it with a double.
+"""
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import signal
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+PROTOCOL_HEADER = "X-CrowdMemory-Protocol-Major"
+TOKEN_HEADER = "X-CrowdMemory-Adapter-Token"
+
+
+@pytest.fixture
+def state_root():
+    root = Path(tempfile.mkdtemp(prefix="cld-", dir="/tmp"))
+    yield root
+    shutil.rmtree(root, ignore_errors=True)
+
+
+def _spawn(root: Path) -> tuple[subprocess.Popen, dict]:
+    (root / "endpoint.json").unlink(missing_ok=True)
+    process = subprocess.Popen(
+        [sys.executable, "-m", "crowdmemory_runtime", "serve-dev", "--state-root", str(root),
+         "--socket", str(root / "runtime.sock"), "--profile", "session-default"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, env={**os.environ, "HOME": str(root)},
+    )
+    deadline = time.monotonic() + 20
+    while time.monotonic() < deadline:
+        if (root / "endpoint.json").is_file() and (root / "runtime.sock").exists():
+            return process, json.loads((root / "endpoint.json").read_text())
+        if process.poll() is not None:
+            raise AssertionError(process.stderr.read().decode())
+        time.sleep(0.05)
+    process.kill()
+    raise AssertionError("serve-dev did not publish endpoint.json")
+
+
+def _stop(process: subprocess.Popen) -> bytes:
+    if process.poll() is None:
+        process.send_signal(signal.SIGTERM)
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+    return process.stderr.read()
+
+
+def _exchange(socket_path: str, request: bytes) -> bytes:
+    """Write a hand-built HTTP request and return the raw response bytes (b"" means the peer hung up first)."""
+    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    connection.settimeout(5.0)
+    try:
+        connection.connect(socket_path)
+        connection.sendall(request)
+        # Half-close so a server that waits for a body we will never send ends at EOF instead of a hung test.
+        connection.shutdown(socket.SHUT_WR)
+        chunks = []
+        while True:
+            block = connection.recv(65536)
+            if not block:
+                break
+            chunks.append(block)
+    finally:
+        connection.close()
+    return b"".join(chunks)
+
+
+def _request(socket_path: str, method: str, target: str, headers: list[tuple[str, str]]) -> bytes:
+    lines = [f"{method} {target} HTTP/1.1", "Host: localhost", *[f"{name}: {value}" for name, value in headers]]
+    return ("\r\n".join(lines) + "\r\n\r\n").encode("ascii")
+
+
+def _parse(response: bytes) -> tuple[int, dict]:
+    assert response, "server closed the connection without writing any HTTP response"
+    head, separator, body = response.partition(b"\r\n\r\n")
+    assert separator, f"incomplete HTTP response: {response[:200]!r}"
+    status_line = head.split(b"\r\n", 1)[0].split()
+    assert status_line[0].startswith(b"HTTP/1."), response[:80]
+    return int(status_line[1]), json.loads(body.decode("utf-8"))
+
+
+def _assert_healthy(status: int, value: dict) -> None:
+    """``GET /v1/status`` answers with the Runtime's status body itself (no ``ok`` wrapper)."""
+    assert status == 200, value
+    assert value["service_identity"] == "memory-runtime", value
+    assert value["status"] in {"ready", "disabled"}, value
+    assert "error" not in value, value
+
+
+def _get_status(socket_path: str, *, protocol: str | None = "1", length: str | None = None) -> bytes:
+    headers = []
+    if protocol is not None:
+        headers.append((PROTOCOL_HEADER, protocol))
+    if length is not None:
+        headers.append(("Content-Length", length))
+    return _exchange(socket_path, _request(socket_path, "GET", "/v1/status", headers))
+
+
+def test_invalid_content_length_is_structured_400_and_service_keeps_serving(state_root) -> None:
+    process, endpoint = _spawn(state_root)
+    socket_path = endpoint["socket_path"]
+    try:
+        # a legitimate request works before anything goes wrong
+        status, value = _parse(_get_status(socket_path, length="0"))
+        _assert_healthy(status, value)
+        healthy = value
+
+        # the reported failure: protocol header present, Content-Length is not a number
+        raw = _get_status(socket_path, length="abc")
+        status, value = _parse(raw)
+        assert status == 400, raw[:300]
+        assert value["ok"] is False, value
+        assert value["error"]["code"] == "invalid_content_length", value
+        assert value["error"]["retryable"] is False, value
+        assert isinstance(value["error"]["message"], str) and value["error"]["message"], value
+        assert value["error"]["code"] != "invalid_json", "a framing defect must not be reported as a body defect"
+
+        # ... and the very next request still succeeds on the same server
+        status, value = _parse(_get_status(socket_path, length="0"))
+        _assert_healthy(status, value)
+        assert value == healthy, "a rejected framing must not disturb the served state"
+
+        # an oversized declaration is still refused as before, with its own code
+        status, value = _parse(_get_status(socket_path, length=str(4 * 1024 * 1024 + 1)))
+        assert status == 413 and value["error"]["code"] == "request_too_large", value
+    finally:
+        stderr = _stop(process)
+    assert b"Traceback (most recent call last)" not in stderr, stderr.decode("utf-8", "replace")[-2000:]
