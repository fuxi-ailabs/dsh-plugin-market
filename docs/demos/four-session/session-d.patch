--- /dev/null
+++ b/tests/test_http_length_demo.py
@@ -0,0 +1,224 @@
+"""Content-Length framing over the real Unix-socket HTTP front end.
+
+The failure this pins down: ``Handler._handle`` parses ``Content-Length`` before reading, and an
+unparsable value used to escape as ``ValueError`` — ``BaseHTTPRequestHandler`` turns that into a
+silent disconnect with zero bytes written, so the client cannot tell a framing bug from a crash.
+The test starts the real ``serve-dev`` process and speaks raw HTTP/1.1 over AF_UNIX on purpose:
+mocking the handler would skip exactly the framing layer under test.
+"""
+from __future__ import annotations
+
+import hashlib
+import http.client
+import json
+import os
+import shutil
+import signal
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+CAPS = ["session_binding", "step_injection", "tool_capture", "compaction_capture", "subagent_capture", "note_tool", "query_tools"]
+MAX_MESSAGE_BYTES = 4 * 1024 * 1024
+
+
+class _UnixConnection(http.client.HTTPConnection):
+    def __init__(self, socket_path: str, timeout: float = 5.0):
+        super().__init__("localhost", timeout=timeout)
+        self._socket_path = socket_path
+
+    def connect(self) -> None:
+        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        sock.settimeout(self.timeout)
+        sock.connect(self._socket_path)
+        self.sock = sock
+
+
+def _raw_exchange(socket_path: str, request: bytes, *, half_close: bool = True, timeout: float = 5.0) -> bytes:
+    """Send ``request`` verbatim and read until EOF; SHUT_WR keeps the server from waiting on a body."""
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    sock.settimeout(timeout)
+    sock.connect(socket_path)
+    try:
+        sock.sendall(request)
+        if half_close:
+            sock.shutdown(socket.SHUT_WR)
+        chunks: list[bytes] = []
+        while True:
+            data = sock.recv(65536)
+            if not data:
+                break
+            chunks.append(data)
+        return b"".join(chunks)
+    finally:
+        sock.close()
+
+
+def _split_response(response: bytes) -> tuple[int, dict, dict]:
+    head, _, payload = response.partition(b"\r\n\r\n")
+    assert head, f"server closed the connection without writing any HTTP response (got {response!r})"
+    lines = head.decode("latin-1").split("\r\n")
+    status = int(lines[0].split(" ")[1])
+    headers = {}
+    for line in lines[1:]:
+        name, _, value = line.partition(":")
+        headers[name.strip().lower()] = value.strip()
+    return status, headers, json.loads(payload)
+
+
+def _session_start_body() -> str:
+    return json.dumps({
+        "adapter_id": "dsh",
+        "event_id": "sha256:" + hashlib.sha256(f"session.start:{time.time_ns()}".encode()).hexdigest(),
+        "session_ref": "dsh-length-1",
+        "parent_ref": None,
+        "occurred_at": "2026-10-20T00:00:00Z",
+        "kind": "session.start",
+        "payload": {"project": "demo", "profile_ref": "session-default", "capabilities": CAPS},
+    })
+
+
+def _headers(endpoint: dict, *, content_length: str | None, protocol_major: str = "1") -> str:
+    token = Path(endpoint["token_file"]).read_text(encoding="utf-8").strip()
+    lines = [
+        "Content-Type: application/json",
+        f"X-CrowdMemory-Protocol-Major: {protocol_major}",
+        f"X-CrowdMemory-Adapter-Token: {token}",
+    ]
+    if content_length is not None:
+        lines.append(f"Content-Length: {content_length}")
+    return "".join(f"{line}\r\n" for line in lines)
+
+
+def _raw_post(endpoint: dict, body: str, *, content_length: str | None, path: str = "/v1/agent-ingress/dsh/events/session.start",
+              protocol_major: str = "1") -> bytes:
+    request = (
+        f"POST {path} HTTP/1.1\r\n"
+        + _headers(endpoint, content_length=content_length, protocol_major=protocol_major)
+        + "\r\n"
+        + body
+    ).encode("utf-8")
+    return _raw_exchange(endpoint["socket_path"], request)
+
+
+def _post(endpoint: dict, kind: str, payload: dict, *, session_ref: str = "dsh-length-1") -> tuple[int, dict]:
+    body = json.loads(_session_start_body())
+    body.update({"event_id": "sha256:" + hashlib.sha256(f"{kind}:{time.time_ns()}".encode()).hexdigest(),
+                 "session_ref": session_ref, "kind": kind, "payload": payload})
+    token = Path(endpoint["token_file"]).read_text(encoding="utf-8").strip()
+    connection = _UnixConnection(endpoint["socket_path"])
+    try:
+        connection.request("POST", f"/v1/agent-ingress/dsh/events/{kind}", body=json.dumps(body),
+                           headers={"Content-Type": "application/json", "X-CrowdMemory-Protocol-Major": "1",
+                                    "X-CrowdMemory-Adapter-Token": token})
+        response = connection.getresponse()
+        return response.status, json.loads(response.read())
+    finally:
+        connection.close()
+
+
+def _get_status(endpoint: dict) -> tuple[int, dict]:
+    token = Path(endpoint["token_file"]).read_text(encoding="utf-8").strip()
+    connection = _UnixConnection(endpoint["socket_path"])
+    try:
+        connection.request("GET", "/v1/agent-ingress/status",
+                           headers={"X-CrowdMemory-Protocol-Major": "1", "X-CrowdMemory-Adapter-Token": token})
+        response = connection.getresponse()
+        return response.status, json.loads(response.read())
+    finally:
+        connection.close()
+
+
+@pytest.fixture
+def state_root():
+    root = Path(tempfile.mkdtemp(prefix="exi-len-", dir="/tmp"))
+    yield root
+    shutil.rmtree(root, ignore_errors=True)
+
+
+def _spawn(root: Path) -> tuple[subprocess.Popen, dict]:
+    (root / "endpoint.json").unlink(missing_ok=True)
+    process = subprocess.Popen(
+        [sys.executable, "-m", "crowdmemory_runtime", "serve-dev", "--state-root", str(root),
+         "--socket", str(root / "runtime.sock"), "--profile", "session-default"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, env={**os.environ, "HOME": str(root)},
+    )
+    deadline = time.monotonic() + 20
+    while time.monotonic() < deadline:
+        if (root / "endpoint.json").is_file() and (root / "runtime.sock").exists():
+            return process, json.loads((root / "endpoint.json").read_text())
+        if process.poll() is not None:
+            raise AssertionError(process.stderr.read().decode())
+        time.sleep(0.05)
+    process.kill()
+    raise AssertionError("serve-dev did not publish endpoint.json")
+
+
+def _stop(process: subprocess.Popen) -> tuple[str, str]:
+    if process.poll() is None:
+        process.send_signal(signal.SIGTERM)
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+    return (process.stdout.read().decode(errors="replace") if process.stdout else "",
+            process.stderr.read().decode(errors="replace") if process.stderr else "")
+
+
+def test_invalid_content_length_returns_structured_400_then_service_keeps_working(state_root) -> None:
+    process, endpoint = _spawn(state_root)
+    try:
+        # 1) 非法 Content-Length 必须得到结构化 400，而不是零字节断连
+        body = _session_start_body()
+        for bad in ("abc", "1e3", "3.0", " 12x"):
+            status, headers, value = _split_response(_raw_post(endpoint, body, content_length=bad))
+            assert status == 400, (bad, value)
+            assert headers["content-type"].startswith("application/json")
+            assert value["ok"] is False
+            assert value["error"]["code"] == "invalid_content_length", (bad, value)
+
+        # 2) 同一条路由的合法 POST 仍然创建会话
+        status, value = _post(endpoint, "session.start",
+                              {"project": "demo", "profile_ref": "session-default", "capabilities": CAPS})
+        assert status == 200 and value["ok"], value
+        handle = value["result"]["session_handle"]
+
+        # 3) 再接一次非法长度：同一进程内的后续连接不受影响
+        status, _, value = _split_response(_raw_post(endpoint, body, content_length="abc"))
+        assert status == 400 and value["error"]["code"] == "invalid_content_length", value
+
+        # 4) 之后的 GET 状态查询仍成功，且会话确实创建了
+        status, status_value = _get_status(endpoint)
+        assert status == 200 and status_value["ok"], status_value
+        assert status_value["result"]["sessions"]["active"] == 1, status_value
+        assert handle.startswith("ash_")
+
+        # 5) 分帧合法但协议 major 不匹配，仍是 protocol_incompatible（没被长度缺陷掩盖）
+        status, _, value = _split_response(_raw_post(endpoint, body, content_length=str(len(body.encode())), protocol_major="9"))
+        assert status == 400 and value["error"]["code"] == "protocol_incompatible", value
+    finally:
+        _, stderr = _stop(process)
+    assert "Traceback" not in stderr, stderr
+
+
+def test_oversized_content_length_still_413(state_root) -> None:
+    process, endpoint = _spawn(state_root)
+    try:
+        status, _, value = _split_response(
+            _raw_post(endpoint, "", content_length=str(MAX_MESSAGE_BYTES + 1))
+        )
+        assert status == 413, value
+        assert value["error"]["code"] == "request_too_large", value
+        # 过大长度之后，正常请求照常
+        status, value = _post(endpoint, "session.start", {"project": "demo", "capabilities": CAPS})
+        assert status == 200 and value["ok"], value
+    finally:
+        _, stderr = _stop(process)
+    assert "Traceback" not in stderr, stderr
