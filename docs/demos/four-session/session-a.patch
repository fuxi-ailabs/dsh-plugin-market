--- /dev/null
+++ b/tests/test_http_length_demo.py
@@ -0,0 +1,154 @@
+"""HTTP Content-Length 解析：非法值必须是结构化 400，而不是让连接静默断连。
+
+真实服务（``crowdmemory_runtime serve-dev``）经 Unix socket 提供 HTTP；这里直接用原始 socket
+发字节，因此断言的是线上行为（状态行 + 正文），不经过任何 Handler mock。
+"""
+from __future__ import annotations
+
+import json
+import os
+import signal
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+import shutil
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+PROTOCOL_HEADER = "X-CrowdMemory-Protocol-Major"
+MAX_MESSAGE_BYTES = 4 * 1024 * 1024
+
+
+def _spawn(root: Path) -> tuple[subprocess.Popen, str]:
+    (root / "endpoint.json").unlink(missing_ok=True)
+    process = subprocess.Popen(
+        [sys.executable, "-m", "crowdmemory_runtime", "serve-dev", "--state-root", str(root),
+         "--socket", str(root / "runtime.sock"), "--profile", "session-default"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, env={**os.environ, "HOME": str(root)},
+    )
+    deadline = time.monotonic() + 20
+    while time.monotonic() < deadline:
+        if (root / "endpoint.json").is_file() and (root / "runtime.sock").exists():
+            return process, str(root / "runtime.sock")
+        if process.poll() is not None:
+            raise AssertionError(process.stderr.read().decode())
+        time.sleep(0.05)
+    process.kill()
+    raise AssertionError("serve-dev did not publish endpoint.json")
+
+
+def _stop(process: subprocess.Popen) -> None:
+    if process.poll() is None:
+        process.send_signal(signal.SIGTERM)
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+
+
+def _raw_request(socket_path: str, request: bytes, *, timeout: float = 5.0) -> bytes:
+    """发原始字节，读到底；连接被对端关闭时返回已读到的部分（可能为空）。"""
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    sock.settimeout(timeout)
+    sock.connect(socket_path)
+    try:
+        sock.sendall(request)
+        chunks: list[bytes] = []
+        while True:
+            block = sock.recv(65536)
+            if not block:
+                break
+            chunks.append(block)
+        return b"".join(chunks)
+    finally:
+        sock.close()
+
+
+def _get(socket_path: str, *extra_headers: str) -> bytes:
+    lines = ["GET /v1/status HTTP/1.1", "Host: unix", f"{PROTOCOL_HEADER}: 1", *extra_headers]
+    return _raw_request(socket_path, ("\r\n".join(lines) + "\r\n\r\n").encode("ascii"))
+
+
+def _split(response: bytes) -> tuple[int, dict[str, str], bytes]:
+    """拆 HTTP 响应；空响应（断连）会在这里留下可读的失败信息而不是 IndexError。"""
+    assert response, "连接被直接关闭，没有收到任何 HTTP 响应"
+    head, sep, body = response.partition(b"\r\n\r\n")
+    assert sep, f"响应不完整: {response[:200]!r}"
+    lines = head.decode("iso-8859-1").split("\r\n")
+    status_line = lines[0].split()
+    assert len(status_line) >= 2 and status_line[1].isdigit(), status_line[0]
+    headers = {}
+    for line in lines[1:]:
+        name, _, value = line.partition(":")
+        headers[name.strip().lower()] = value.strip()
+    return int(status_line[1]), headers, body
+
+
+def _json_body(status: int, headers: dict[str, str], body: bytes) -> dict[str, Any]:
+    # 正文必须完整：声明的 Content-Length 与实际字节数一致，否则客户端会读到截断的 JSON
+    assert int(headers["content-length"]) == len(body), (headers.get("content-length"), len(body))
+    assert headers["content-type"].startswith("application/json"), headers.get("content-type")
+    value = json.loads(body.decode("utf-8"))
+    assert isinstance(value, dict), value
+    return value
+
+
+def _assert_status_ok(socket_path: str) -> None:
+    """合法 GET /v1/status 仍然工作（该路由直接返回 runtime 状态对象，没有 ok 包装）。"""
+    status, headers, body = _split(_get(socket_path))
+    assert status == 200
+    value = _json_body(status, headers, body)
+    assert value["service_identity"] == "memory-runtime", value.get("service_identity")
+    assert value["status"] in {"ready", "disabled"}, value.get("status")
+
+
+@pytest.fixture
+def memory_server():
+    root = Path(tempfile.mkdtemp(prefix="http-length-", dir="/tmp"))
+    process, socket_path = _spawn(root)
+    try:
+        yield socket_path
+    finally:
+        _stop(process)
+        shutil.rmtree(root, ignore_errors=True)
+
+
+def test_legal_status_request_succeeds(memory_server) -> None:
+    _assert_status_ok(memory_server)
+
+
+def test_invalid_content_length_returns_structured_400_then_keeps_serving(memory_server) -> None:
+    # 非法 Content-Length 既不能 200，也不能断连：必须是可以被客户端解析的 400
+    status, headers, body = _split(_get(memory_server, "Content-Length: abc"))
+    assert status == 400
+    value = _json_body(status, headers, body)
+    assert value["ok"] is False
+    assert value["error"]["code"] == "invalid_content_length"
+    assert isinstance(value["error"]["message"], str) and value["error"]["message"]
+    assert value["error"]["retryable"] is False
+
+    # 同一个服务实例继续工作：坏请求只影响它自己那一次连接
+    _assert_status_ok(memory_server)
+
+
+def test_non_numeric_content_length_variants_are_rejected(memory_server) -> None:
+    for bad in ("abc", "1.5", "12x", "-", "0x10"):
+        status, headers, body = _split(_get(memory_server, f"Content-Length: {bad}"))
+        assert status == 400, (bad, status, body[:200])
+        assert _json_body(status, headers, body)["error"]["code"] == "invalid_content_length", bad
+    # 坏请求之后正常请求不受影响
+    _assert_status_ok(memory_server)
+
+
+def test_oversized_content_length_still_413(memory_server) -> None:
+    status, headers, body = _split(_get(memory_server, f"Content-Length: {MAX_MESSAGE_BYTES + 1}"))
+    assert status == 413
+    value = _json_body(status, headers, body)
+    assert value["ok"] is False
+    assert value["error"]["code"] == "request_too_large"
+    _assert_status_ok(memory_server)
