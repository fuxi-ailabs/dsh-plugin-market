diff --git a/tests/test_http_length_demo.py b/tests/test_http_length_demo.py
new file mode 100644
index 0000000..d1ad627
--- /dev/null
+++ b/tests/test_http_length_demo.py
@@ -0,0 +1,209 @@
+"""Real serve-dev over a Unix socket: request framing errors must stay structured JSON, never a disconnect.
+
+``Content-Length: abc`` used to raise ``ValueError`` inside ``Handler._handle`` before any response
+was written, so the client saw an empty reply (connection closed with no HTTP status).  These tests
+drive a real ``crowdmemory_runtime serve-dev`` process over its Unix socket and assert the wire
+behaviour end to end: structured 400 for an unframed length, still-structured 413 for an oversized
+one, and a healthy service for the valid POST / GET traffic that follows.
+"""
+from __future__ import annotations
+
+import hashlib
+import http.client
+import json
+import os
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+CAPS = ["session_binding", "step_injection", "tool_capture", "compaction_capture",
+        "subagent_capture", "note_tool", "query_tools"]
+PROTOCOL_MAJOR = "1"
+
+
+class _UnixConnection(http.client.HTTPConnection):
+    def __init__(self, socket_path: str, timeout: float = 10.0):
+        super().__init__("localhost", timeout=timeout)
+        self._socket_path = socket_path
+
+    def connect(self) -> None:
+        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        sock.settimeout(self.timeout)
+        sock.connect(self._socket_path)
+        self.sock = sock
+
+
+def _spawn(root: Path) -> tuple[subprocess.Popen, dict]:
+    (root / "endpoint.json").unlink(missing_ok=True)
+    process = subprocess.Popen(
+        [sys.executable, "-m", "crowdmemory_runtime", "serve-dev", "--state-root", str(root),
+         "--socket", str(root / "runtime.sock"), "--profile", "session-default"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, env={**os.environ, "HOME": str(root)},
+    )
+    deadline = time.monotonic() + 20
+    while time.monotonic() < deadline:
+        if (root / "endpoint.json").is_file() and (root / "runtime.sock").exists():
+            return process, json.loads((root / "endpoint.json").read_text())
+        if process.poll() is not None:
+            raise AssertionError(process.stderr.read().decode())
+        time.sleep(0.05)
+    process.kill()
+    raise AssertionError("serve-dev did not publish endpoint.json")
+
+
+def _stop(process: subprocess.Popen) -> None:
+    if process.poll() is None:
+        process.terminate()
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+
+
+@pytest.fixture
+def service():
+    root = Path(tempfile.mkdtemp(prefix="exi-len-", dir="/tmp"))
+    process, endpoint = _spawn(root)
+    try:
+        yield endpoint, process
+    finally:
+        _stop(process)
+        shutil.rmtree(root, ignore_errors=True)
+
+
+def _event(kind: str, payload: dict, *, session_ref: str = "dsh-len") -> dict:
+    return {
+        "adapter_id": "dsh",
+        "event_id": "sha256:" + hashlib.sha256(f"{kind}:{time.time_ns()}:{id(payload)}".encode()).hexdigest(),
+        "session_ref": session_ref,
+        "parent_ref": None,
+        "occurred_at": "2026-10-20T00:00:00Z",
+        "kind": kind,
+        "payload": payload,
+    }
+
+
+def _headers(endpoint: dict, **extra: str | None) -> dict:
+    token = Path(endpoint["token_file"]).read_text(encoding="utf-8").strip()
+    sent = {"X-CrowdMemory-Protocol-Major": PROTOCOL_MAJOR, "X-CrowdMemory-Adapter-Token": token}
+    sent.update(extra)
+    return {key: value for key, value in sent.items() if value is not None}
+
+
+def _call(endpoint: dict, method: str, target: str, body: dict | None = None) -> tuple[int, dict]:
+    """Ordinary request through http.client; a disconnect surfaces as an assertion, not a silent pass."""
+    payload = None if body is None else json.dumps(body)
+    sent = _headers(endpoint, **{"Content-Type": "application/json"} if body is not None else {})
+    connection = _UnixConnection(endpoint["socket_path"])
+    try:
+        connection.request(method, target, body=payload, headers=sent)
+        response = connection.getresponse()
+        return response.status, json.loads(response.read())
+    finally:
+        connection.close()
+
+
+def _raw(endpoint: dict, request: bytes) -> bytes:
+    """Send raw bytes; return the full reply, or b"" when the server closed without answering."""
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    sock.settimeout(10.0)
+    sock.connect(endpoint["socket_path"])
+    try:
+        sock.sendall(request)
+        chunks = []
+        while True:
+            chunk = sock.recv(65536)
+            if not chunk:
+                return b"".join(chunks)
+            chunks.append(chunk)
+    except ConnectionResetError:
+        return b"".join(chunks)
+    finally:
+        sock.close()
+
+
+def _raw_post(endpoint: dict, content_length: str, body: bytes | None = None) -> bytes:
+    token = Path(endpoint["token_file"]).read_text(encoding="utf-8").strip()
+    head = (
+        b"POST /v1/agent-ingress/dsh/events/session.start HTTP/1.1\r\n"
+        b"Host: localhost\r\n"
+        b"X-CrowdMemory-Protocol-Major: " + PROTOCOL_MAJOR.encode() + b"\r\n"
+        b"X-CrowdMemory-Adapter-Token: " + token.encode() + b"\r\n"
+        b"Content-Type: application/json\r\n"
+        b"Content-Length: " + content_length.encode() + b"\r\n\r\n"
+    )
+    return _raw(endpoint, head + (body or b""))
+
+
+def _split(reply: bytes) -> tuple[int, dict]:
+    assert reply, "服务端在写完响应前就断开了连接（客户端只收到空响应）"
+    head, _, body = reply.partition(b"\r\n\r\n")
+    status_line = head.split(b"\r\n", 1)[0].decode("latin-1")
+    parts = status_line.split(" ", 2)
+    assert len(parts) >= 2 and parts[0].startswith("HTTP/"), status_line
+    return int(parts[1]), json.loads(body)
+
+
+def test_invalid_content_length_returns_structured_400(service) -> None:
+    endpoint, _ = service
+    status, value = _split(_raw_post(endpoint, "abc"))
+    assert status == 400, value
+    assert value["ok"] is False
+    assert value["error"]["code"] == "invalid_content_length", value
+    assert isinstance(value["error"]["message"], str) and value["error"]["message"]
+    assert value["error"]["retryable"] is False
+
+
+def test_invalid_content_length_with_body_in_flight_still_answers(service) -> None:
+    """A client that pipelines headers+body must still read the 400 instead of losing it to a reset."""
+    endpoint, _ = service
+    body = json.dumps(_event("session.start", {"project": "demo", "capabilities": CAPS})).encode()
+    status, value = _split(_raw_post(endpoint, "abc", body))
+    assert status == 400, value
+    assert value["error"]["code"] == "invalid_content_length", value
+
+
+def test_valid_post_then_status_then_further_requests(service) -> None:
+    endpoint, process = service
+    status, value = _call(endpoint, "POST", "/v1/agent-ingress/dsh/events/session.start",
+                          _event("session.start", {"project": "demo", "profile_ref": "session-default",
+                                                   "capabilities": CAPS}))
+    assert status == 200 and value["ok"], value
+    handle = value["result"]["session_handle"]
+    assert value["result"]["profile"]["id"] == "session-default"
+
+    status, value = _call(endpoint, "GET", "/v1/agent-ingress/status")
+    assert status == 200 and value["ok"], value
+    assert value["result"]["sessions"]["active"] == 1
+
+    # a framing error in between must not poison later traffic on the same server
+    assert _split(_raw_post(endpoint, "abc"))[0] == 400
+    status, value = _call(endpoint, "POST", "/v1/agent-ingress/dsh/events/step.before",
+                          _event("step.before", {"session_handle": handle, "step": 1}))
+    assert status == 200 and value["ok"], value
+    status, value = _call(endpoint, "POST", "/v1/agent-ingress/dsh/events/session.end",
+                          _event("session.end", {"session_handle": handle, "reason": "agent_disposed"}))
+    assert status == 200 and value["ok"], value
+    status, value = _call(endpoint, "GET", "/v1/agent-ingress/status")
+    assert status == 200 and value["ok"], value
+    assert value["result"]["sessions"]["ended"] == 1
+    assert process.poll() is None
+
+
+def test_oversized_content_length_still_returns_413(service) -> None:
+    endpoint, _ = service
+    status, value = _split(_raw_post(endpoint, str(4 * 1024 * 1024 + 1)))
+    assert status == 413, value
+    assert value["error"]["code"] == "request_too_large", value
+    # the service keeps serving after the rejection
+    status, value = _call(endpoint, "POST", "/v1/agent-ingress/dsh/events/session.start",
+                          _event("session.start", {"project": "demo", "capabilities": CAPS}))
+    assert status == 200 and value["ok"], value
