--- a/info/CMakeLists.txt
+++ b/info/CMakeLists.txt
@@ -1,7 +1,12 @@
 cmake_minimum_required(VERSION 3.20)
 project(png_info_demo C)
 find_package(PNG REQUIRED)
+# PNG::PNG 的 INTERFACE_INCLUDE_DIRECTORIES 默认以 -isystem 传递，会排在
+# /usr/local/include 之后，导致命中旧版 png.h（1.6.43）而链接 1.6.59 库。
+# 关闭 imported target 的系统化，让 -I 生效，保证头文件与二进制同一版本。
+set(CMAKE_NO_SYSTEM_FROM_IMPORTED ON)
 add_executable(png_info main.c)
 target_include_directories(png_info PRIVATE ${PNG_INCLUDE_DIRS})
+target_link_libraries(png_info PRIVATE PNG::PNG)
 enable_testing()
 add_test(NAME png_info_reads_fixture COMMAND png_info ${CMAKE_CURRENT_SOURCE_DIR}/../fixtures/sample.png)
